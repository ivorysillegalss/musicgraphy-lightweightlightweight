# 复制为 .env 后按需修改；生产（NODE_ENV=production）缺失 ACCESS_KEY/SESSION_SECRET 将 fail-fast
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# 单用户访问密钥（登录页凭据）
ACCESS_KEY=change-me
# 会话 cookie 的 HMAC 签名密钥（>=32 字节随机串）
SESSION_SECRET=change-me-32-bytes-random

# 元数据上游 User-Agent 合规标识（MusicBrainz 必填，格式见复审 V2）
USER_AGENT=Musicgraphy/0.1.0 (+https://musicgraphy.example; contact@example)
